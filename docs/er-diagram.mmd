---
config:
  layout: elk
---
erDiagram
    direction LR
    GOODS_RECEIPT ||..o{ PALLET : contains
    BEVERAGE ||..o{ PALLET : "ordered as"
    BEVERAGE ||..o{ PACKAGING_UNIT : "filled into"
    PALLET |o..o{ PACKAGING_UNIT : "unpacked into"
    PACKAGING_UNIT ||--o{ DELIVERY_ITEM : "included in"
    DELIVERY ||--o{ DELIVERY_ITEM : contains

    BEVERAGE {
        int id PK
        string name UK
        string type "beer | soft_drink"
    }
    GOODS_RECEIPT {
        int id PK
        date receipt_date
        string supplier
        int expected_pallet_count "optional, from delivery slip"
    }
    PALLET {
        int id PK
        int goods_receipt_id FK
        int beverage_id FK
        string container_type
        int quantity ">= 0"
        date best_before_date
    }
    PACKAGING_UNIT {
        int id PK
        string container_type "keg_* | crate_*"
        string status "full | empty | cleaned"
        int beverage_id FK
        date best_before_date
        int received_via_pallet_id FK "optional"
    }
    DELIVERY {
        int id PK
        date delivery_date
        string customer
    }
    DELIVERY_ITEM {
        int delivery_id PK, FK
        int unit_id PK, FK
    }
